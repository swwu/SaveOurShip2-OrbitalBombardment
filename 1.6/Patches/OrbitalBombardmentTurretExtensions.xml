<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Adds OrbitalBombardmentTurretExtension to Save Our Ship 2 turret/building ThingDefs.
       Values chosen:
         Laser-class: travelTimePerTile=10 (fast), minForcedMissRadius=18, isLaser=true
         Standard projectile: travelTimePerTile=60, minForcedMissRadius=35
         Railgun (kinetic high-velocity): travelTimePerTile=45, minForcedMissRadius=35
         Torpedoes (slow): travelTimePerTile=90, minForcedMissRadius=45
       Adjust later as desired; these override fallback constants only when specified. -->

  <!-- Autocannon turrets (projectile) -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="ShipTurret_ACI" and not(modExtensions)]</xpath>
        <match Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="ShipTurret_ACI"]</xpath>
          <value><modExtensions/></value>
        </match>
      </li>
      <li Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="ShipTurret_ACI"]/modExtensions</xpath><value>
        <li Class="SaveOurShip2_OrbitalBombardment.OrbitalBombardmentTurretExtension">
          <travelTimePerTile>60</travelTimePerTile>
          <minForcedMissRadius>35</minForcedMissRadius>
        </li>
      </value></li>
    </operations>
  </Operation>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="ShipTurret_ACII" and not(modExtensions)]</xpath>
