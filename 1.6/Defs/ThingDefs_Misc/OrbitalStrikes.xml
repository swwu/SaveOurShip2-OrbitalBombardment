<Defs>
    <ThingDef ParentName="OrbitalStrikeBase">
        <defName>PowerBeamSpinalLaser</defName>
        <label>power beam</label>
        <thingClass>SaveOurShip2_OrbitalBombardment.MovingPowerBeam</thingClass>
        <comps>
            <li Class="CompProperties_OrbitalBeam">
                <width>14</width>
                <color>(255, 0, 0, 245)</color>
                <sound>OrbitalBeam</sound>
            </li>
            <li Class="CompProperties_CameraShaker">
                <mag>0.06</mag>
            </li>
            <li Class="CompProperties_AffectsSky">
                <skyColors>
                    <sky>(255, 0, 0)</sky>
                    <shadow>(60, 100, 150)</shadow>
                    <overlay>(255, 255, 255)</overlay>
                    <saturation>1.9</saturation>
                </skyColors>
            </li>
        </comps>
        <modExtensions>
            <li Class="SaveOurShip2_OrbitalBombardment.MovingPowerBeamExtension">
                <enableMovement>true</enableMovement>
                <path>arc</path>
                <arcBulgeFactor>0.35</arcBulgeFactor>
                <speedCellsPerSec>2.6</speedCellsPerSec>
                <explosionEveryTicks>20</explosionEveryTicks>
                <explosionRadius>2.5</explosionRadius>
                <explosionDamage>45</explosionDamage>
                <explosionDamageDef>Bomb</explosionDamageDef>
            </li>
        </modExtensions>
    </ThingDef>

